# PHASE 1: copy to .env. Values below match compose.yaml; never use them in production.
# Runtime PostgreSQL URL; obtain production connection details from your database host.
DATABASE_URL="postgresql://velnaura:velnaura_local_only@localhost:5432/velnaura?schema=public"
# Direct (unpooled) PostgreSQL URL for migrations; obtain from the same database host.
DIRECT_URL="postgresql://velnaura:velnaura_local_only@localhost:5432/velnaura?schema=public"
# Your local/deployed public origin; used to construct future auth/payment return URLs.
APP_URL="http://localhost:3000"
# Explicit local seed opt-in. Seed refuses production and non-loopback database hosts.
ALLOW_DEV_SEED="false"
# Choose distinct local test passwords of at least 12 characters; never use production credentials.
SEED_CUSTOMER_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# AUTHENTICATION: required for the current auth system.
# Auth.js encryption/signing secret. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Auth.js canonical origin; set to your deployed HTTPS origin in production.
AUTH_URL="http://localhost:3000"
# Enable ONLY behind a trusted proxy that sanitizes forwarded host headers (Auth.js deployment docs).
# AUTH_TRUST_HOST="true"
# Reserved SMTP contract for a later real email transport; not consumed by the console transport.
SMTP_HOST=""
SMTP_PORT="587"
# true for implicit TLS (typically 465); false for STARTTLS (typically 587).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Verified sender address from your mail provider; choose a domain you control.
EMAIL_FROM=""

# FUTURE PAYMENTS: app-owned names below form the integration contract; no gateway is called yet.
# Select sandbox for development, production only after merchant activation.
SAFEPAY_ENVIRONMENT="sandbox"
# Public API key and private API secret: Safepay dashboard > Developers > API, for the selected environment.
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
# Webhook signing secret: Safepay dashboard > Developers > Endpoints > shared secret.
SAFEPAY_WEBHOOK_SECRET=""
# Register this HTTPS endpoint with Safepay; local development needs your own HTTPS tunnel.
# Planned route only; it is NOT implemented in this phase.
SAFEPAY_WEBHOOK_URL="http://localhost:3000/api/payments/safepay/webhook"
# Choose future browser return/cancel routes on APP_URL. Neither route exists in this phase.
PAYMENT_RETURN_URL="http://localhost:3000/checkout/return"
PAYMENT_CANCEL_URL="http://localhost:3000/checkout"
# Supported merchant payment methods, confirmed with Safepay during onboarding; do not enable unactivated wallets.
PAYMENT_ENABLED_METHODS="CARD,BANK_TRANSFER,COD"
# Manual bank-transfer display details: obtain from Velnaura's receiving bank/account owner.
BANK_TRANSFER_BANK_NAME=""
BANK_TRANSFER_ACCOUNT_TITLE=""
BANK_TRANSFER_IBAN=""
BANK_TRANSFER_INSTRUCTIONS=""

# OPTIONAL DIRECT JAZZCASH FALLBACK: leave blank when using Safepay; no extra merchant credentials needed for aggregation.
# Obtain these from JazzCash merchant onboarding / the sandbox merchant portal.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# Exact hosted-checkout URL assigned/documented by JazzCash for your approved integration and environment.
JAZZCASH_CHECKOUT_URL=""
# Your registered return URL; select during direct merchant integration.
JAZZCASH_RETURN_URL=""

# OPTIONAL DIRECT EASYPAISA FALLBACK: leave blank when using Safepay.
# Obtain store ID, API username/password and hash key from Easypaisa's merchant integration team.
# Credential requirements vary by approved product (hosted checkout vs APIs); confirm before Phase 4 implementation.
EASYPAISA_STORE_ID=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_HASH_KEY=""
# Exact endpoint and registered postback URL for the merchant product/environment approved by Easypaisa.
EASYPAISA_API_URL=""
EASYPAISA_POSTBACK_URL=""

# NODE_ENV is set by Next.js (development for dev, production for build/start).
# Do not override it in .env; the seed refuses production mode.
# Currency is intentionally fixed to PKR in schema/code, not an environment toggle.

# Local reset-email delivery only: logs the email, including the reset link, to the server terminal.
# Production always refuses console delivery with HTTP 503; implement lib/email.ts for a real provider.
EMAIL_DELIVERY_MODE="console"
# Set true only when a trusted reverse proxy overwrites x-real-ip; otherwise shared-client limits apply.
AUTH_TRUST_PROXY_IP="false"
